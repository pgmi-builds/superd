{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "esnext.disposable"
    ],
    "types": [
      "node"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/client",
    "src/mobile/client"
  ]
}
