{
  "name": "@pgmi-builds/agent-hub",
  "version": "0.1.0",
  "description": "Agent Worlds hub host half: world inventory control plane, roster, world spawner and the single-origin per-world mount carrier (no server-side selection; the addressed world is the request's mount path)",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client/index.js",
    "./world": "./dist/world-entry.js",
    "./join": "./dist/world-join.js"
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "build-client": "node scripts/build-client.mjs",
    "test": "node --test --test-force-exit test/*.test.mjs"
  },
  "dependencies": {
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-api-gateway": "*",
    "@deepseek-ai/dsh-host-webserver": "*",
    "@deepseek-ai/dsh-typert-protocol": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-typert-protocol": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsdown": "^0.15.12",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
